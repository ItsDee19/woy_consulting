# Copy to .env.local for development; set production values in Vercel project settings.
# Never commit populated environment files or paste credentials into issues/logs.
# Set your verified public origin when the final domain is known.
SITE_URL=https://example.com

# Server-only HTTPS delivery handler accepting POST FormData:
# name/email/organisation/message/id/consent/privacyNoticeVersion.
# It MUST honour Idempotency-Key for at least 24 hours, including ambiguous timeouts.
CONTACT_ENDPOINT=
# Optional Bearer token required by your delivery handler.
CONTACT_ENDPOINT_TOKEN=
# Required in production: independent random secret of at least 32 characters.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONTACT_FORM_SECRET=

# Shared rate limits and delivery deduplication across Vercel instances.
# URL must be the root HTTPS *.upstash.io REST endpoint; token needs EVAL read/write access.
# Prefer separate production/preview databases and credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile managed widget. Restrict its allowed hostnames in Cloudflare.
# The site key is a public widget ID; only it is passed to the contact page.
# Secret key remains on the server. Never use test keys in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# VERCEL and VERCEL_ENV are supplied by the hosting platform; do not set them manually.
# Only Vercel's overwritten x-vercel-forwarded-for header is trusted for visitor IPs.
# Production fails closed without Redis, Turnstile, signing and delivery configuration.
# Development alone can use bounded local counters; never use that fallback publicly.

# Optional: keep a public pre-launch website out of search.
# Local and Vercel preview deployments remain noindex automatically.
SITE_INDEXING=
