# Copy to .env.local for development and configure the same keys with your host.
# Canonical public origin for metadata, sitemap, and form origin checks.
SITE_URL=https://woyconsulting.com

# Server-only HTTPS delivery endpoint, accepting POST FormData (name/mobile/email).
# Returns 2xx only when accepted. Never prefix these keys with NEXT_PUBLIC_.
# If unset, the form clearly reports unavailable; it never pretends to send.
CONTACT_ENDPOINT=
# Optional Bearer token if your delivery handler requires authentication.
CONTACT_ENDPOINT_TOKEN=
# Required in production: a random secret of at least 32 characters.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONTACT_FORM_SECRET=

# Optional client-IP header that your trusted edge proxy ALWAYS overwrites.
# Leave empty unless your host guarantees clients cannot spoof that header.
# Otherwise, limits use a signed browser cookie plus a global circuit breaker.
CONTACT_RATE_LIMIT_IP_HEADER=

# Contact limits use bounded process memory: 5 attempts per sender / 15 minutes
# and 100 deliveries globally / 15 minutes. For multiple instances/serverless,
# additionally configure shared edge/WAF limits for /api/contact. Restarts reset
# counters; challenge cookies remain signed using CONTACT_FORM_SECRET.

# Optional: keep a public staging or pre-launch site out of search.
# Leave empty for normal production indexing; local and Vercel previews remain noindex.
SITE_INDEXING=
