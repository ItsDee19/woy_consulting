# Copy to .env.local for development, and set the same keys in the Vercel
# project under Settings > Environment Variables.

# The canonical site origin. Set this once the real domain points at Vercel.
# If unset, the app falls back to the Vercel production or preview domain,
# then to localhost. Used for metadataBase, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://woyconsulting.com

# Where the contact form posts. Any handler that accepts a POST of FormData
# and returns 2xx works, for example a Formspree endpoint.
# Leave unset to run the form in demo mode: it validates and reports success
# without sending anything.
NEXT_PUBLIC_CONTACT_ENDPOINT=
